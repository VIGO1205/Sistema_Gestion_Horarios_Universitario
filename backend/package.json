    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/run-seeds.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
