{
  "name": "backend-horarios-universidad",
  "version": "1.0.0",
  "description": "Backend NestJS para Sistema de Gestión de Horarios - UNT",
  "author": "Ingeniería de Software I",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build": "nest build",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
