{
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test",
        "**/*spec.ts"
    ],
    "compilerOptions": {
        "resolveJsonModule": true,
        "declarationMap": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false,
        "lib": [
            "ES2020"
        ],
        "target": "ES2020",
        "esModuleInterop": true,
        "rootDir": "./src",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "experimentalDecorators": true,
        "baseUrl": "./",
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "declaration": true,
        "module": "commonjs"
    }
}